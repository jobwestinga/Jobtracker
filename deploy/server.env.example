# Copy to `deploy/server.env` and fill in your own values.
#
# `deploy/server.env` is gitignored on purpose: this repository is public, and
# there is no reason to publish the name of your server, your login on it, or
# your private network's hostname. Nothing secret belongs here either — API
# tokens live only on the server (hashed) and in your password manager.

# Login used for ssh and for running the service.
JT_SSH_USER=youruser
JT_SSH_HOST=your.server.example

# Where the service lives on the server.
JT_ROOT=/home/youruser/jobtracker

# The tailnet name Tailscale gives the server, and its 100.x address.
JT_TAILNET_HOST=yourserver.your-tailnet.ts.net
JT_TAILNET_IP=100.0.0.0

# Port `tailscale serve` publishes on. 443 is the obvious choice, but pick
# another (8443) if something else on the box already binds 443 — a reverse
# proxy on 0.0.0.0:443 will intercept tailnet traffic and fail the handshake.
JT_HTTPS_PORT=8443

# Port uvicorn binds on localhost. Never exposed directly.
JT_API_PORT=8099
