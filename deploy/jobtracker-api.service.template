[Unit]
Description=JobTracker API (authoritative store for the desktop app and the phone)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=__JT_SSH_USER__
WorkingDirectory=__JT_ROOT__/app
Environment=JOBTRACKER_DB_PATH=__JT_ROOT__/data/jobtracker.db
Environment=JOBTRACKER_TOKENS_PATH=__JT_ROOT__/secrets/tokens.json
Environment=PYTHONUNBUFFERED=1
# Bound to localhost only. Other devices reach it through `tailscale serve`, so
# the API is never listening on a public interface.
ExecStart=__JT_ROOT__/venv/bin/uvicorn server.app:app --host 127.0.0.1 --port __JT_API_PORT__ --workers 1
Restart=on-failure
RestartSec=3

# The service needs nothing outside its own directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__JT_ROOT__/data __JT_ROOT__/secrets
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
